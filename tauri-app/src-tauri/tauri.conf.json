{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "practicum-tracker",
  "version": "0.1.0",
  "identifier": "com.tomz.practicum-tracker",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Practicum Tracker",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tracker"
    ]
  }
}